# ============================================
#  洛书 bot 配置模板（Linux 部署参考）
# ============================================
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
#
# 注意：等号两边不要加空格；JSON 数组用双引号。

ENVIRONMENT=prod

# 监听地址：
#   127.0.0.1  仅本机（登录程序也在这台机器）
#   0.0.0.0    对外（登录程序在另一台机器，通过 ws-reverse 连过来）
#              若用 0.0.0.0，请务必在防火墙/安全组只放行可信来源！
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
FASTAPI_RELOAD=false

# ===== 管理员 / 超级用户 QQ 号（可多个）=====
# 改成你自己的 QQ 号（这是「管理员」，享有管理功能）
SUPERUSERS=["请填写管理员QQ号"]

# ===== 洛书喜欢的人（河图）的称呼 =====
MASTER_NAMES=麻花,河图

# ===== 机器人昵称 / 唤醒词 =====
NICKNAME=["洛书", "洛"]
CALL_NAMES=洛书,洛洛,小洛,洛

# ===== 命令前缀 =====
COMMAND_START=["/"]
COMMAND_SEP=["."]

# ===== 会话超时（ISO8601 时长，PT1M = 1 分钟）=====
SESSION_EXPIRE_TIMEOUT=PT1M

# ===== 本地大模型（Ollama）=====
# 同机运行用 127.0.0.1；Ollama 在别的机器则改成其地址
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180

# ===== AI 对话保留的历史轮数 =====
AI_MAX_HISTORY=20

# ===== AI 回复是否 @ 发送者 =====
AI_AT_SENDER=false

# ===== 定时问好 =====
GREETING_ENABLED=true
GREETING_GROUPS=[]
