# ============================================
#  洛书 bot 配置模板（Linux 部署参考）
# ============================================
# ⚠️⚠️ 安全警告（务必先读） ⚠️⚠️
#   本文件只是「模板」，不含任何真实信息，可以安全提交到仓库。
#   但复制出来的 .env 里会包含【你的真实 QQ 号、群号、乃至真实姓名】，
#   属于隐私信息，一旦上传到公开仓库会被任何人看到，且很难彻底删除。
#
#   请务必确认：
#     1. .env 已被 .gitignore 忽略（本项目默认已忽略，勿删该规则）
#     2. 不要用 git add -f .env 强制添加
#     3. 上传前跑一次 `git status`，确认看不到 .env / .env.prod
#     4. 若曾误传，立刻改掉相关信息并到平台清理历史
# ============================================
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
#
# 注意：等号两边不要加空格；JSON 数组用双引号。

ENVIRONMENT=prod

# 监听地址：
#   127.0.0.1  仅本机（登录程序也在这台机器）
#   0.0.0.0    对外（登录程序在另一台机器，通过 ws-reverse 连过来）
#              若用 0.0.0.0，请务必在防火墙/安全组只放行可信来源！
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
FASTAPI_RELOAD=false

# ===== 管理员 / 超级用户 QQ 号（可多个）=====
# 改成你自己的 QQ 号（这是「管理员」，享有管理功能）
SUPERUSERS=[]

# ===== 洛书「偷偷喜欢的人」的称呼（可多个，逗号分隔）=====
# 触发「心动专属互动」的对象，通常也应写进上面的 SUPERUSERS（管理员）。
# 默认占位符「小美」——换成你喜欢的人的名字即可。
CRUSH_NAMES=小美

# 熟人互动对象，可与管理员分开。省略时沿用 SUPERUSERS；[] 表示不启用熟人互动。
# FAMILIAR_USERS=["100000000"]

# ===== 机器人昵称 / 唤醒词 =====
NICKNAME=["洛书", "洛"]
CALL_NAMES=洛书,洛洛,小洛,洛

# ===== 命令前缀 =====
COMMAND_START=["/"]
COMMAND_SEP=["."]

# ===== 会话超时（ISO8601 时长，PT1M = 1 分钟）=====
SESSION_EXPIRE_TIMEOUT=PT1M

# ===== 本地大模型（Ollama）=====
# 同机运行用 127.0.0.1；Ollama 在别的机器则改成其地址
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT=180

# ===== AI 对话保留的历史轮数 =====
AI_MAX_HISTORY=20

# 并发请求上限、上下文窗口、最大生成 token 数（分别控制排队与显存/耗时）
AI_MAX_CONCURRENT=2
AI_CONTEXT_SIZE=4096
AI_NUM_PREDICT=512
# auto=由模型默认决定，true=思考，false=不思考；支持该参数的模型才显式设置
OLLAMA_THINK=auto

# ===== AI 会话多久不活动就自动清理（天，0=不清理）=====
AI_SESSION_TTL_DAYS=30

# ===== AI 回复是否 @ 发送者 =====
AI_AT_SENDER=false

# ===== 定时问好 =====
GREETING_ENABLED=true
GREETING_GROUPS=[]
